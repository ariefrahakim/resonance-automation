{
  "info": {
    "_postman_id": "resonance-automation-collection",
    "name": "Resonance API Collection",
    "description": "Koleksi pengujian API untuk aplikasi Resonance (https://resonance.dibimbing.id).\nMencakup endpoint: Auth, Tiket, Komentar, Progres, Vote, dan Utilitas.\n\nCara penggunaan:\n1. Import collection ini ke Postman\n2. Set environment variable: baseUrl, token\n3. Jalankan request Auth > Login terlebih dahulu untuk mendapatkan token\n4. Token otomatis disimpan via Test script",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://resonance.dibimbing.id",
      "type": "string",
      "description": "Base URL aplikasi Resonance"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT Token dari hasil login"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string",
      "description": "ID tiket yang dibuat, dipakai oleh request lain"
    },
    {
      "key": "commentId",
      "value": "",
      "type": "string",
      "description": "ID komentar yang dibuat"
    },
    {
      "key": "progressionId",
      "value": "",
      "type": "string",
      "description": "ID progres yang dibuat"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Endpoint autentikasi pengguna",
      "item": [
        {
          "name": "Login - Sukses",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Verifikasi status code 200",
                  "pm.test('Status code 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Verifikasi token ada di respons",
                  "pm.test('Token dikembalikan', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "// Simpan token ke collection variable untuk digunakan request berikutnya",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);",
                  "console.log('Token berhasil disimpan:', json.token.substring(0, 20) + '...');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"user1\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rest/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rest", "login"]
            },
            "description": "Login dengan username dan password. Token JWT disimpan otomatis ke variable."
          }
        },
        {
          "name": "Login - Kredensial Tidak Valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Login dengan kredensial salah harus gagal (bukan 200)",
                  "pm.test('Status code bukan 200 untuk kredensial tidak valid', function () {",
                  "    pm.expect(pm.response.code).to.not.equal(200);",
                  "});",
                  "",
                  "pm.test('Response berisi pesan error', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('message');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"user_tidak_ada@test.com\",\n  \"password\": \"passwordsalah\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rest/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rest", "login"]
            },
            "description": "Skenario negatif: login dengan email yang tidak terdaftar."
          }
        }
      ]
    },
    {
      "name": "Tickets",
