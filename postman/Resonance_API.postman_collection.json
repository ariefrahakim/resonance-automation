{
  "info": {
    "_postman_id": "resonance-api-bearer-v2",
    "name": "Resonance API",
    "description": "Resonance API Collection — Bearer Token Auth.\n\nEnvironment Variables (sama dengan config.properties):\n  baseUrl         = https://resonance.dibimbing.id\n  token           = (auto-saved after login)\n  ticketId        = (auto-saved after createTicket)\n  commentId       = (auto-saved after createComment)\n  progressionId   = (auto-saved after createProgression)\n\nUrutan eksekusi yang disarankan:\n  Auth > Login → Tickets > Create Ticket → Comments > Create Comment\n  → Progressions > Create Progression → Votes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",         "value": "https://resonance.dibimbing.id", "type": "string" },
    { "key": "username",        "value": "user1",    "type": "string" },
    { "key": "password",        "value": "password", "type": "string" },
    { "key": "token",           "value": "",         "type": "string" },
    { "key": "ticketId",        "value": "",         "type": "string" },
    { "key": "commentId",       "value": "",         "type": "string" },
    { "key": "progressionId",   "value": "",         "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request: log which request is about to run",
          "console.log('[PRE] Running:', pm.info.requestName);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level test: always check response time",
          "pm.test('Response time < 5000ms', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
          "// Log status for every request",
          "console.log('[POST] Status:', pm.response.status, '| Time:', pm.response.responseTime + 'ms');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Login (Save Bearer Token)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Use collection variables — matches config.properties",
                  "const username = pm.collectionVariables.get('username') || 'user1';",
                  "const password = pm.collectionVariables.get('password') || 'password';",
                  "pm.request.body.raw = JSON.stringify({ usernameOrEmail: username, password: password });",
                  "console.log('[AUTH PRE] Logging in as:', username);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-AUTH-001: Login berhasil dengan kredensial valid",
                  "pm.test('TC-AUTH-001 | Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('TC-AUTH-001 | ok = true', () => pm.expect(pm.response.json().ok).to.be.true);",
                  "pm.test('TC-AUTH-001 | token is string', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "pm.test('TC-AUTH-001 | user.id exists', () => pm.expect(pm.response.json().user.id).to.be.a('string'));",
                  "",
                  "// Save Bearer token — same key as Java BaseApiTest TOKEN_FILE",
                  "if (pm.response.json().token) {",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "    console.log('[AUTH POST] Bearer token saved:', pm.response.json().token.substring(0, 25) + '...');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/rest/login", "host": ["{{baseUrl}}"], "path": ["api","rest","login"] }
          }
        },
        {
          "name": "POST Login - Invalid Password (Negative)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["console.log('[AUTH NEG PRE] Testing invalid password...');"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-AUTH-002: Login gagal — password salah",
                  "pm.test('TC-AUTH-002 | Status bukan 200', () => pm.response.to.not.have.status(200));",
                  "pm.test('TC-AUTH-002 | Error message exists', () => pm.expect(pm.response.json()).to.have.property('message'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usernameOrEmail\": \"{{username}}\",\n  \"password\": \"wrongpassword\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/rest/login", "host": ["{{baseUrl}}"], "path": ["api","rest","login"] }
          }
        },
        {
          "name": "POST Login - Empty Fields (Negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-AUTH-003: Login gagal — field kosong",
                  "pm.test('TC-AUTH-003 | Status bukan 200', () => pm.response.to.not.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usernameOrEmail\": \"\",\n  \"password\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/rest/login", "host": ["{{baseUrl}}"], "path": ["api","rest","login"] }
