              "script": {
                "type": "text/javascript",
                "exec": [
                  "// TC-TICKET-001: Membuat tiket publik",
                  "pm.test('TC-TICKET-001 | Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('TC-TICKET-001 | id exists', () => pm.expect(pm.response.json().id).to.be.a('string'));",
                  "pm.test('TC-TICKET-001 | title matches', () => pm.expect(pm.response.json().title).to.equal(pm.variables.get('uniqueTitle')));",
