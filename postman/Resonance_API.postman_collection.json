                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"usernameOrEmail\": \"{{username}}\",\n  \"password\": \"ab\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/rest/login", "host": ["{{baseUrl}}"], "path": ["api","rest","login"] }
          }
        }
      ]
